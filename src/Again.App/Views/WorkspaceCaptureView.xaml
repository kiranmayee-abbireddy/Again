<UserControl x:Class="Again.App.Views.WorkspaceCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Again.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:WorkspaceCaptureViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Capture Desktop Workspace" Style="{StaticResource HeaderTitleStyle}" />
                    <TextBlock Text="Snapshot your current screen layout or select non-running apps to configure and restore in one click." Style="{StaticResource SubheaderStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0" Height="32" Padding="14,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" Height="32" Padding="18,0" VerticalAlignment="Center">
                        <TextBlock Text="Save Workspace" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Error Banner -->
            <Border Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}" 
                    Background="{DynamicResource DangerBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,18">
                <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="#FFFFFF" FontWeight="Medium" />
            </Border>

            <!-- Configuration Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Workspace Information" Style="{StaticResource SectionTitleStyle}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Workspace Name" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Category" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Description (Optional)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="48" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Applications Header & Actions -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Applications in Workspace" Style="{StaticResource SectionTitleStyle}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding SummaryCountText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Add Non-Running App Button -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ToggleAppPickerCommand}" Height="30" Padding="12,0" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#FFFFFF" />
                            <TextBlock Text="Add Non-Running App" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButtonStyle}" Content="Select All" Command="{Binding SelectAllCommand}" Height="30" Padding="8,0" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="Deselect All" Command="{Binding DeselectAllCommand}" Height="30" Padding="8,0" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ScanWindowsCommand}" Height="30" Padding="12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Rescan Windows" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Collapsible App Picker Panel for Non-Running Apps -->
            <Border Visibility="{Binding IsAppPickerOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource CardBorderStyle}" Background="{DynamicResource WindowBackgroundBrush}" 
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Select Non-Running Applications" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Pick from installed applications on this computer or browse for any executable." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseCustomAppCommand}" Height="30" Padding="12,0" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Browse Executable (.exe)..." FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Command="{Binding CloseAppPickerCommand}" Height="30" Width="30" Padding="0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource SymbolFont}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- Search installed apps -->
                    <Grid Margin="0,0,0,12">
                        <TextBox Text="{Binding CatalogSearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="32,0,10,0" VerticalContentAlignment="Center" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Search installed apps (e.g. Chrome, VS Code, Discord, Spotify, Notepad)..." Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" Margin="32,0,10,0" VerticalAlignment="Center"
                                   Visibility="{Binding CatalogSearchQuery, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                    </Grid>

                    <!-- Scrollable list of catalog apps -->
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilteredCatalogApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewmodels:CatalogAppItemViewModel}">
                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ExecutablePath}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="10,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.AddCatalogAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource SymbolFont}" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Add" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Applications List -->
            <ItemsControl ItemsSource="{Binding DetectedWindows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:CapturableWindowItemViewModel}">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                <!-- App Icon -->
                                <TextBlock Grid.Column="1" Text="{Binding IconGlyph}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />

                                <!-- App Details -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center" />

                                        <!-- Offline / Not Running Badge -->
                                        <Border Visibility="{Binding IsNotRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource AccentLightBrush}" BorderThickness="1"
                                                CornerRadius="4" Height="20" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource SymbolFont}" FontSize="10" Margin="0,0,4,0" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="Not Running (Will Launch on Restore)" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Browser Profile Badge -->
                                        <Border Visibility="{Binding HasBrowserProfile, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                CornerRadius="4" Height="20" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource SymbolFont}" FontSize="10" Margin="0,0,4,0" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding BrowserProfile}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Folder View Path Badge -->
                                        <Border Visibility="{Binding HasFolderViewPath, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                CornerRadius="4" Height="20" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource SymbolFont}" FontSize="10" Margin="0,0,4,0" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FolderViewPath}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    
                                    <!-- Browser Tabs Summary -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2" Visibility="{Binding HasTabs, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Margin="0,0,4,0" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TabsSummary}" FontSize="11" Foreground="{DynamicResource AccentLightBrush}" TextTrimming="CharacterEllipsis" MaxWidth="500" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Placement & Remove Action -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding PlacementText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding MonitorText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <!-- Remove Button for Manually Added Non-Running Apps -->
                                    <Button Visibility="{Binding IsNotRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource GhostButtonStyle}" Height="28" Width="28" Padding="0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Remove from workspace">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource SymbolFont}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
