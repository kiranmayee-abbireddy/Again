<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Rosewood Light Theme -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FAF7F8" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFE4E6" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#F2E6E8" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1517" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#604C50" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A18E92" />

    <Color x:Key="AccentColor">#E11D48</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#BE123C" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#F43F5E" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#E11D48" />

    <!-- Navigation Active Accent -->
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#FFF1F2" />
    <SolidColorBrush x:Key="NavActiveBorderBrush" Color="#FECDD3" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="InfoBrush" Color="#E11D48" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#E5DADB" />

</ResourceDictionary>
