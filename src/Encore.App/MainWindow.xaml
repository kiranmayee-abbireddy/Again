<Window x:Class="Encore.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Encore.App.ViewModels"
        xmlns:views="clr-namespace:Encore.App.Views"
        mc:Ignorable="d"
        Title="Again — Your workspace, back on stage" 
        Icon="Assets/icon.png"
        Height="760" Width="1140" MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                     ResizeBorderThickness="6"
                     CornerRadius="0"
                     GlassFrameThickness="0"
                     UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:WorkspaceLibraryViewModel}">
            <views:WorkspaceLibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:WorkspaceDetailsViewModel}">
            <views:WorkspaceDetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:WorkspaceCaptureViewModel}">
            <views:WorkspaceCaptureView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ApplicationManagerViewModel}">
            <views:ApplicationManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" 
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header & Custom Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Height="56" Padding="16,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand / Logo (Left) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="Transparent" Margin="0,0,10,0">
                            <Image Source="Assets/icon.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="AGAIN" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v1.0" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Your workspace, back on stage." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Draggable Space (WindowChrome drag) -->
                    <Grid Grid.Column="1" Background="Transparent" />

                    <!-- Top Quick Action Buttons (Exact Same Height: 32px) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding QuickCaptureCommand}" 
                                Height="32" Margin="0,0,8,0" Padding="12,0" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE722;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Capture" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource RestoreButtonStyle}" 
                                Command="{Binding QuickRestoreLastUsedCommand}" 
                                Height="32" Padding="14,0" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Quick Restore" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Theme-Aligned Window Controls: Minimize, Maximize/Restore, Close -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource WindowCaptionButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Rectangle Width="10" Height="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>

                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource WindowCaptionButtonStyle}"
                                Click="MaximizeButton_Click"
                                ToolTip="Maximize"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="11" Height="11">
                                <Rectangle x:Name="MaximizeIcon" Width="10" Height="10" 
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                           StrokeThickness="1.2" />
                                <Canvas x:Name="RestoreIcon" Width="11" Height="11" Visibility="Collapsed">
                                    <Path Data="M 3,0 H 11 V 8 H 8 V 11 H 0 V 3 H 3 V 0 Z M 3,3 H 8 V 8" 
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                          StrokeThickness="1.1" />
                                </Canvas>
                            </Grid>
                        </Button>

                        <Button x:Name="CloseButton"
                                Style="{StaticResource WindowCloseButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Close"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" 
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                  StrokeThickness="1.2" 
                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        <!-- Main Body: Sidebar + Active Content View -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation Rail -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="12,16">
                <DockPanel LastChildFill="True">
                    
                    <!-- App Status / Shortcuts Hint in Bottom of Sidebar -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="GLOBAL SHORTCUTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Capture" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Ctrl+Alt+C" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource AccentLightBrush}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Restore" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Ctrl+Alt+R" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource AccentLightBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Items List -->
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:NavigationItem}">
                                <RadioButton GroupName="NavMenu" IsChecked="{Binding IsSelected}" 
                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding}" Margin="0,0,0,6">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="navBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Subtle Left Indicator Bar -->
                                                                <Border x:Name="activeIndicator" Grid.Column="0" Width="3" Height="18" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0" Visibility="Collapsed" />
                                                                <TextBlock x:Name="navGlyph" Grid.Column="1" Text="{Binding Glyph}" FontFamily="{StaticResource SymbolFont}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="navTitle" Grid.Column="2" Text="{Binding Title}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}" />
                                                                <Setter TargetName="navBorder" Property="BorderBrush" Value="{DynamicResource NavActiveBorderBrush}" />
                                                                <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible" />
                                                                <Setter TargetName="navTitle" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Setter TargetName="navTitle" Property="FontWeight" Value="SemiBold" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Active View Content Container -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="18,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Windows 10 / 11 Native" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding CurrentTheme, StringFormat='Theme: {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
    </Border>
</Window>
