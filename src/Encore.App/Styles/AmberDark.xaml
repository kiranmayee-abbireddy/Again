<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Solar Amber Dark Theme -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#121214" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#18181B" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#27272A" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#18181B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#27272A" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A" />

    <SolidColorBrush x:Key="AccentBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D97706" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#F59E0B" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush" Color="#F59E0B" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#121214" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#27272A" />

</ResourceDictionary>
