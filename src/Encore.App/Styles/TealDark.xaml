<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nordic Teal Dark Theme -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0A0E17" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#334155" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1E293B" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

    <SolidColorBrush x:Key="AccentBrush" Color="#06B6D4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0891B2" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#22D3EE" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#06B6D4" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush" Color="#06B6D4" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0A0E17" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#1E293B" />

</ResourceDictionary>
