<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Rosewood Dark Theme -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#140E14" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1A131A" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#2B1D2B" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#3E2A3E" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A131A" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2B1D2B" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF1F2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FDA4AF" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9F1239" />

    <Color x:Key="AccentColor">#F43F5E</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#F43F5E" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#FB7185" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#F43F5E" />

    <!-- Navigation Active Accent -->
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#331422" />
    <SolidColorBrush x:Key="NavActiveBorderBrush" Color="#66203F" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush" Color="#F43F5E" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#140E14" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2B1D2B" />

</ResourceDictionary>
