<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0F19" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#374151" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E2638" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2D3748" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280" />

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#818CF8" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#06B6D4" />

    <!-- States -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6" />

    <!-- Controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#374151" />

</ResourceDictionary>
