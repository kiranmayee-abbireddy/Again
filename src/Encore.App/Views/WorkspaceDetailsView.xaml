<UserControl x:Class="Encore.App.Views.WorkspaceDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Encore.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:WorkspaceDetailsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">

            <!-- Top Navigation & Action Header -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back to Library Button -->
                <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding GoBackCommand}" Margin="0,0,16,0" Height="32" Padding="14,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Back to Library" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1" Text="Workspace Configuration" Style="{StaticResource HeaderTitleStyle}" VerticalAlignment="Center" />

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Save Changes" Command="{Binding SaveCommand}" Margin="0,0,10,0" Height="32" Padding="16,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource RestoreButtonStyle}" Command="{Binding RestoreNowCommand}" Height="32" Padding="16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Foreground="#FFFFFF" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="Restore Workspace Now" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Banner -->
            <Border Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" 
                    Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{DynamicResource AccentLightBrush}" />
            </Border>

            <!-- Restoring Banner -->
            <Border Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibilityConverter}}" 
                    Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource SymbolFont}" FontSize="14" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RestoringMessage}" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Workspace Metadata Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="General Details" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Workspace Name" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Category" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Description (Optional)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" />
                </StackPanel>
            </Border>

            <!-- Applications List Section Header & Add App Action -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE71D;" FontFamily="{StaticResource SymbolFont}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="Configured Applications &amp; Windows" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding Applications.Count, StringFormat='{}{0} applications'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />

                <!-- Add Application Button -->
                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ToggleAddAppCommand}" Height="30" Padding="12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#FFFFFF" />
                        <TextBlock Text="Add Application" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Collapsible Add Application Picker Panel -->
            <Border Visibility="{Binding IsAddAppOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource CardBorderStyle}" Background="{DynamicResource WindowBackgroundBrush}" 
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Add Application to Workspace" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Select an installed app or browse for any executable on disk to add to this workspace." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseAppCommand}" Height="30" Padding="12,0" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Browse Executable (.exe)..." FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Command="{Binding CloseAddAppCommand}" Height="30" Width="30" Padding="0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource SymbolFont}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- Search installed apps -->
                    <Grid Margin="0,0,0,12">
                        <TextBox Text="{Binding AppSearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="32,0,10,0" VerticalContentAlignment="Center" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Search installed apps (e.g. Chrome, VS Code, Discord, Spotify, Notepad)..." Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" Margin="32,0,10,0" VerticalAlignment="Center"
                                   Visibility="{Binding AppSearchQuery, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                    </Grid>

                    <!-- Scrollable list of catalog apps -->
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilteredCatalogApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewmodels:CatalogAppItemViewModel}">
                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ExecutablePath}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="10,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.AddCatalogAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource SymbolFont}" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Add" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Configured Applications List -->
            <ItemsControl ItemsSource="{Binding Applications}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:WorkspaceAppItemViewModel}">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Padding="18" CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top row: Checkbox, Icon, Name, Order Buttons, Action Buttons -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding IconGlyph}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                            
                                            <!-- Browser Profile Badge -->
                                            <Border Visibility="{Binding HasBrowserProfile, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                    CornerRadius="4" Height="20" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource SymbolFont}" FontSize="10" Margin="0,0,4,0" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding BrowserProfile}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            
                                            <!-- Explorer Folder View Path Badge -->
                                            <Border Visibility="{Binding HasFolderViewPath, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                    CornerRadius="4" Height="20" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource SymbolFont}" FontSize="10" Margin="0,0,4,0" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding FolderViewPath}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Tabs Summary -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2" Visibility="{Binding HasTabs, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Margin="0,0,4,0" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TabsSummary}" FontSize="11" Foreground="{DynamicResource AccentLightBrush}" TextTrimming="CharacterEllipsis" MaxWidth="450" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Reorder buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButtonStyle}" Height="30" Width="30" Padding="0" Margin="0,0,2,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.MoveAppUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Move Up in Launch Sequence">
                                            <TextBlock Text="&#xE70E;" FontFamily="{StaticResource SymbolFont}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Style="{StaticResource GhostButtonStyle}" Height="30" Width="30" Padding="0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.MoveAppDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Move Down in Launch Sequence">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource SymbolFont}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="10,0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.TestLaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Test Launch" FontSize="11.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        
                                        <Button Style="{StaticResource DangerButtonStyle}" Height="30" Padding="10,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Remove" FontSize="11.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Middle row: Window Position, Window State & Monitor details -->
                                <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Target Window Placement:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding WindowBoundsText}" FontSize="12" FontWeight="Medium" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="Window State:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                            <ComboBox ItemsSource="{Binding AvailableWindowStates}" SelectedItem="{Binding SelectedWindowState}" Height="28" VerticalContentAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Monitor Assignment:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding MonitorText}" FontSize="12" FontWeight="Medium" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Bottom row: Launch args & delay -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Launch Arguments" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding LaunchArguments, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Startup Delay (ms)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding LaunchDelayMs, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
