<UserControl x:Class="Encore.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Encore.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:HistoryViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Restoration History" Style="{StaticResource HeaderTitleStyle}" />
                    <TextBlock Text="Audit log of previous workspace restores with duration and status details." Style="{StaticResource SubheaderStyle}" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource DangerButtonStyle}" Command="{Binding ClearHistoryCommand}" Height="32" Padding="14,0" VerticalAlignment="Center">
                    <TextBlock Text="Clear History" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Status Banner -->
            <Border Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" 
                    Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{DynamicResource AccentLightBrush}" />
            </Border>

            <!-- Empty History State -->
            <Border Visibility="{Binding HasSessions, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                    Style="{StaticResource CardBorderStyle}" Padding="32" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource SurfaceBackgroundBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource SymbolFont}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                    </Border>
                    <TextBlock Text="No restoration history yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="When you restore workspaces, timestamps, duration, and status logs will appear here." 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Sessions List -->
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:SessionItemViewModel}">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Badge (Centered Horizontally & Vertically) -->
                                    <Border Grid.Column="0" Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" CornerRadius="4" Height="22" MinWidth="64" Padding="8,0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                    </Border>

                                    <!-- Session Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WorkspaceName}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Duration & Summary -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DurationText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <!-- Action Buttons (Height="30" for Exact Uniformity) -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Retry Failed" 
                                                Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.RetryFailedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Height="30" Padding="10,0" Margin="0,0,8,0" VerticalAlignment="Center" />

                                        <ToggleButton Content="{Binding IsExpanded, Converter={x:Null}}" IsChecked="{Binding IsExpanded}" Height="30" Padding="10,0" VerticalAlignment="Center">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <TextBlock Text="Details" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>

                                <!-- Expanded items breakdown -->
                                <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}" 
                                        Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="6" Padding="14" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Application Breakdown" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="&#xE73E;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ProcessName}" FontSize="13" FontWeight="Medium" />
                                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="{DynamicResource DangerBrush}" 
                                                                           Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
