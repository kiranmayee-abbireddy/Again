<UserControl x:Class="Encore.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Encore.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">
            
            <!-- Hero Command Center Banner -->
            <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="14" 
                    Padding="28" 
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <!-- Live Status Pill -->
                        <Border Background="{DynamicResource WindowBackgroundBrush}" 
                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="10,4" 
                                HorizontalAlignment="Left" 
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="LIVE DESKTOP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding LiveDesktopSummary}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Welcome to Again" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="Your workspace, back on stage. Snapshot your multi-window desktop arrangement and restore your entire flow with one click." 
                                   FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="620" Margin="0,0,0,20" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Primary Snapshot CTA with Hover Glow -->
                            <Button Style="{StaticResource RestoreButtonStyle}" Command="{Binding StartCaptureCommand}" Margin="0,0,12,0" Padding="20,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource SymbolFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Snapshot Current Desktop" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Instant Quick Restore Button -->
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding QuickRestoreCommand}" Padding="16,10" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource SymbolFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Quick Restore Last" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Global Shortcut Pills -->
                            <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="3" Padding="5,2" Margin="0,0,3,0">
                                        <TextBlock Text="Ctrl" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="+" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,3,0" />
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="3" Padding="5,2" Margin="0,0,3,0">
                                        <TextBlock Text="Alt" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="+" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,3,0" />
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="3" Padding="5,2">
                                        <TextBlock Text="C" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="3" Padding="5,2" Margin="0,0,3,0">
                                        <TextBlock Text="Ctrl" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="+" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,3,0" />
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="3" Padding="5,2" Margin="0,0,3,0">
                                        <TextBlock Text="Alt" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="+" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,3,0" />
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="3" Padding="5,2">
                                        <TextBlock Text="R" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Productivity Metrics Badges -->
                    <Border Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" Padding="20,16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="8,0,18,0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource SymbolFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                                    <TextBlock Text="{Binding ActiveMonitorsCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Displays" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2,18,2" />

                            <StackPanel Grid.Column="2" Margin="0,0,18,0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="&#xE737;" FontFamily="{StaticResource SymbolFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                                    <TextBlock Text="{Binding DetectedWindowsCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Live Windows" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Column="3" Width="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2,18,2" />

                            <StackPanel Grid.Column="4" Margin="0,0,8,0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource SymbolFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                                    <TextBlock Text="{Binding TotalWorkspacesCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Stages" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Restoring Banner Overlay -->
            <Border Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibilityConverter}}" 
                    Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource SymbolFont}" FontSize="15" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RestoringMessage}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Active Stage Spotlight ("Currently On Stage") -->
            <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource AccentLightBrush}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    Padding="24,20" 
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <!-- Spotlight Badge -->
                            <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="CURRENTLY ON STAGE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Category Badge -->
                            <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="4" Padding="7,2" Margin="0,0,10,0">
                                <TextBlock Text="{Binding ActiveStageCategory}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>

                            <!-- Display Target Count -->
                            <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="4" Padding="7,2" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Margin="0,0,5,0" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveStageDisplaysText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- App Count -->
                            <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="4" Padding="7,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE737;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Margin="0,0,5,0" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveStageAppCountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Stage Name & Last Restored Time -->
                        <TextBlock Text="{Binding ActiveStageName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ActiveStageRestoredText}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" />

                        <!-- App Previews Icons Strip -->
                        <ItemsControl ItemsSource="{Binding ActiveStageWorkspace.AppPreviews}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewmodels:AppPreviewItem}">
                                    <Border Width="28" Height="28" CornerRadius="6" 
                                            Background="{DynamicResource SurfaceBackgroundBrush}" 
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                                            Margin="0,0,6,0" ToolTip="{Binding DisplayName}">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Spotlight Actions -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Primary Re-align Windows Action -->
                        <Button Style="{StaticResource RestoreButtonStyle}" 
                                Command="{Binding RealignActiveStageCommand}" 
                                Padding="20,12" Margin="0,0,0,10"
                                IsEnabled="{Binding HasActiveStage}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource SymbolFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Re-align Stage Windows" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Secondary Stage Details Button -->
                        <Button Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding OpenWorkspaceDetailsCommand}" 
                                CommandParameter="{Binding ActiveStageWorkspace}" 
                                Padding="16,9"
                                IsEnabled="{Binding HasActiveStage}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Stage Details &amp; Rules" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Engine & System Diagnostics Ribbon -->
            <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="20,14" 
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Placement Engine -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Placement Engine" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding EngineStatusText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2,0,2" />

                    <!-- DPI Awareness -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                            <TextBlock Text="DPI Awareness" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding EngineDpiModeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="3" Width="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2,0,2" />

                    <!-- Daemon & Hotkeys -->
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <TextBlock Text="&#xE737;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                            <TextBlock Text="Background Daemon" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding EngineDaemonText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="5" Width="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2,0,2" />

                    <!-- Restoration Latency Benchmark -->
                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                            <TextBlock Text="Benchmark Speed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding EngineLatencyText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick Stage Switcher Section -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource SymbolFont}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="Quick Stage Switcher" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                    <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="8" Padding="6,2">
                        <TextBlock Text="{Binding TotalWorkspacesCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <Button Style="{StaticResource GhostButtonStyle}" Content="Browse Full Library" Command="{Binding ViewAllWorkspacesCommand}" Grid.Column="1" />
            </Grid>

            <!-- Empty State for Workspaces -->
            <Border Visibility="{Binding HasAnyWorkspaces, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                    Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="28,20" 
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" 
                            Background="{DynamicResource SurfaceBackgroundBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                            Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE722;" FontFamily="{StaticResource SymbolFont}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Ready to snapshot your first stage?" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                        <TextBlock Text="Arrange your windows across your displays, click Snapshot Current Desktop, and Again will remember the exact coordinates, displays, and states." 
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="580" Margin="0,0,0,5" />
                        <TextBlock Text="Global shortcut: Press Ctrl + Alt + C anywhere in Windows to capture instantly." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource RestoreButtonStyle}" 
                            Command="{Binding StartCaptureCommand}" 
                            Padding="16,8" VerticalAlignment="Center" Margin="16,0,0,0"
                            Content="Snapshot Desktop Now" />
                </Grid>
            </Border>

            <!-- Quick Stage Items Grid -->
            <ItemsControl ItemsSource="{Binding AllWorkspaces}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:WorkspaceItemViewModel}">
                        <Border Background="{DynamicResource CardBackgroundBrush}" 
                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Width="295" 
                                Margin="0,0,16,16" 
                                Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Grid.Column="0">
                                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    
                                    <!-- Pinned Badge if Pinned -->
                                    <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="8,2"
                                            Visibility="{Binding Model.IsPinned, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE718;" FontFamily="{StaticResource SymbolFont}" FontSize="9.5" Foreground="#FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="PINNED" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LastRestoredText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                                <!-- App Icons & Compact Count -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- App Icons Strip -->
                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding AppPreviews}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewmodels:AppPreviewItem}">
                                                <Border Width="24" Height="24" CornerRadius="5" 
                                                        Background="{DynamicResource SurfaceBackgroundBrush}" 
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                                                        Margin="0,0,4,0" ToolTip="{Binding DisplayName}">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Compact App Count Pill -->
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompactAppCountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Restore / Details CTAs -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource RestoreButtonStyle}" Content="Switch Stage" 
                                            Command="{Binding DataContext.QuickRestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Details" 
                                            Command="{Binding DataContext.OpenWorkspaceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Live Desktop State & Arrangement Widget -->
            <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="22,18" 
                    Margin="0,0,0,24">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource SymbolFont}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                                <TextBlock Text="Active Desktop Arrangement &amp; Windows" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2">
                                    <TextBlock Text="Real-Time" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Live connected displays, DPI scaling factors, and open application windows on your desktop." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Rescan & Snapshot Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RescanDesktopCommand}" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Rescan Desktop" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartCaptureCommand}" Padding="12,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Snapshot Setup" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Connected Monitors Row -->
                    <ItemsControl ItemsSource="{Binding CurrentMonitors}" Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:LiveMonitorPreviewItem}">
                                <Border Background="{DynamicResource WindowBackgroundBrush}" 
                                        BorderBrush="{DynamicResource CardBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="14,10" 
                                        Margin="0,0,12,8" 
                                        MinWidth="230">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" 
                                                Background="{DynamicResource SurfaceBackgroundBrush}" 
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                                                Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource SymbolFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ResolutionText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding ScaleText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding RoleBadge}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Live Open Windows Grid -->
                    <ItemsControl ItemsSource="{Binding LiveActiveWindows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:LiveWindowPreviewItem}">
                                <Border Background="{DynamicResource WindowBackgroundBrush}" 
                                        BorderBrush="{DynamicResource CardBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12,8" 
                                        Margin="0,0,10,8" 
                                        Width="270">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- App Icon Glyph -->
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" 
                                                Background="{DynamicResource SurfaceBackgroundBrush}" 
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                                                Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IconGlyph}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Title & Process -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                            <TextBlock Text="{Binding ProcessName}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Bounds / State Badge -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="4" Padding="5,1" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding BoundsText}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding StateText}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Recent Restoration Activity History Snippet -->
            <Border Visibility="{Binding HasRestorationHistory, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="22,18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE81C;" FontFamily="{StaticResource SymbolFont}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                                <TextBlock Text="Recent Restoration Activity" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Performance metrics and timeline of recent workspace restorations." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="View Full History" Command="{Binding ViewHistoryCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentRestorations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:RecentHistorySnippetItem}">
                                <Border Background="{DynamicResource WindowBackgroundBrush}" 
                                        BorderBrush="{DynamicResource CardBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="14,10" 
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="0" Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" 
                                                CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>

                                        <!-- Name & Summary -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WorkspaceName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- Relative Time -->
                                        <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0" />

                                        <!-- Duration -->
                                        <Border Grid.Column="3" Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DurationMs, StringFormat='{}{0}ms'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
