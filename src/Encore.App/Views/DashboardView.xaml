<UserControl x:Class="Encore.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Encore.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            
            <!-- Hero Banner -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Welcome to Encore" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="Your workspace, back on stage. Save multi-window arrangements and restore your entire desktop instantly." 
                                   FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="620" Margin="0,0,0,18" />

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartCaptureCommand}" Margin="0,0,12,0" Padding="18,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📸 " FontSize="14" />
                                    <TextBlock Text="Capture Workspace" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding QuickRestoreCommand}" Padding="16,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ " FontSize="14" />
                                    <TextBlock Text="Quick Restore Last" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Metrics Badges -->
                    <Border Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="8,0,20,0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ActiveMonitorsCount}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentCyanBrush}" />
                                <TextBlock Text="Monitors" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Separator Width="1" Background="{DynamicResource CardBorderBrush}" Margin="0,4" />
                            <StackPanel Margin="20,0,20,0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DetectedWindowsCount}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Open Windows" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Separator Width="1" Background="{DynamicResource CardBorderBrush}" Margin="0,4" />
                            <StackPanel Margin="20,0,8,0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalWorkspacesCount}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" />
                                <TextBlock Text="Saved Workspaces" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Restoring Banner -->
            <Border Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibilityConverter}}" 
                    Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⏳ " FontSize="14" Foreground="#FFFFFF" />
                    <TextBlock Text="{Binding RestoringMessage}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                </StackPanel>
            </Border>

            <!-- Pinned Workspaces Section -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Pinned Workspaces" Style="{StaticResource SectionTitleStyle}" Grid.Column="0" />
                <Button Style="{StaticResource GhostButtonStyle}" Content="View All →" Command="{Binding ViewAllWorkspacesCommand}" Grid.Column="1" />
            </Grid>

            <!-- Empty State for Pinned -->
            <Border Visibility="{Binding HasPinnedWorkspaces, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                    Style="{StaticResource CardBorderStyle}" Padding="24" Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📌 No pinned workspaces yet" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="Pin your most frequent workspaces from the Workspaces library to access them here and from the system tray." 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Pinned Items Grid -->
            <ItemsControl ItemsSource="{Binding PinnedWorkspaces}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:WorkspaceItemViewModel}">
                        <Border Style="{StaticResource CardBorderStyle}" Width="280" Margin="0,0,16,16" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Grid.Column="0">
                                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" />
                                    </Border>
                                    <TextBlock Text="📌" FontSize="12" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description, TargetNullValue='No description'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />

                                <TextBlock Text="{Binding AppCountText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" Content="Restore" 
                                            Command="{Binding DataContext.QuickRestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Details" 
                                            Command="{Binding DataContext.OpenWorkspaceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recent Workspaces Section -->
            <TextBlock Text="Recent Workspaces" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />

            <Border Visibility="{Binding HasRecentWorkspaces, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                    Style="{StaticResource CardBorderStyle}" Padding="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🚀 Ready to capture your first workspace?" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="Arrange your applications on your desktop, click Capture Workspace, and Encore will remember the entire setup." 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Capture Desktop Now" Command="{Binding StartCaptureCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding RecentWorkspaces}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:WorkspaceItemViewModel}">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,0,10,0" />
                                        <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource AccentLightBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding LastRestoredText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding AppCountText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,24,0" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Restore" 
                                            Command="{Binding DataContext.QuickRestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Margin="0,0,8,0" Padding="16,6" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="View" 
                                            Command="{Binding DataContext.OpenWorkspaceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Padding="12,6" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
