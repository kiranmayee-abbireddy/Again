<UserControl x:Class="Encore.App.Views.WorkspaceLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Encore.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:WorkspaceLibraryViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Workspaces Library" Style="{StaticResource HeaderTitleStyle}" />
                    <TextBlock Text="Browse, restore, edit, duplicate and organize your saved workspaces." Style="{StaticResource SubheaderStyle}" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartCaptureCommand}" VerticalAlignment="Center" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📸 " />
                        <TextBlock Text="New Workspace" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Search and Filter Bar -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search Input -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" />
                        <TextBlock Text="🔍 Search workspaces by name, application, or description..." 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   IsHitTestVisible="False" Margin="12,8"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Category Pills -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="Category: " VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" />
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding}" Margin="0,0,8,0" Padding="10,4"
                                                 GroupName="CategoriesGroup"
                                                 IsChecked="{Binding DataContext.SelectedCategory, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, Converter={x:Null}}">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="pill" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Restoring Banner -->
            <Border Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibilityConverter}}" 
                    Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⏳ " FontSize="14" Foreground="#FFFFFF" />
                    <TextBlock Text="{Binding RestoringStatusText}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                </StackPanel>
            </Border>

            <!-- Workspace Cards Grid -->
            <ItemsControl ItemsSource="{Binding FilteredWorkspaces}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:WorkspaceItemViewModel}">
                        <Border Style="{StaticResource CardBorderStyle}" Width="310" Margin="0,0,16,16" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Category and Pin -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Grid.Column="0">
                                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" />
                                    </Border>

                                    <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Padding="6,2"
                                            Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" ToolTip="Toggle Pin">
                                        <TextBlock Text="{Binding IsPinned, Converter={StaticResource PinGlyphConverter}}" FontSize="14" />
                                    </Button>
                                </Grid>

                                <!-- Title -->
                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />

                                <!-- Description -->
                                <TextBlock Grid.Row="2" Text="{Binding Description, TargetNullValue='No description provided'}" 
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" 
                                           TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="0,0,0,14" />

                                <!-- Metadata -->
                                <Grid Grid.Row="3" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding AppCountText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding LastRestoredText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Action Buttons -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" Content="Restore" 
                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Margin="0,0,6,0" />

                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Details" 
                                            Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Margin="0,0,4,0" Padding="8,7" ToolTip="View &amp; Edit Apps" />

                                    <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="📋" 
                                            Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Margin="0,0,2,0" Padding="6,6" ToolTip="Duplicate" />

                                    <Button Grid.Column="3" Style="{StaticResource GhostButtonStyle}" Content="🗑️" 
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Padding="6,6" ToolTip="Delete" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
