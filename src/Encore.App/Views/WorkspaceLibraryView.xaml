<UserControl x:Class="Encore.App.Views.WorkspaceLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Encore.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:WorkspaceLibraryViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">

            <!-- Header -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="Workspaces Library" Style="{StaticResource HeaderTitleStyle}" Margin="0,0,12,0" />
                        <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FilteredWorkspaces.Count, StringFormat='{}{0} Available'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Browse, restore, edit, duplicate, and organize all your saved workspaces." Style="{StaticResource SubheaderStyle}" Margin="0" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartCaptureCommand}" VerticalAlignment="Center" Height="34" Padding="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource SymbolFont}" FontSize="13" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="New Workspace" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Search and Filter Bar -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search Input with Vector Search Icon (Compact 34px) -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="34,0,12,0" VerticalContentAlignment="Center" />
                        <!-- Left Vector Search Icon -->
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource SymbolFont}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" 
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                        <!-- Placeholder -->
                        <TextBlock Text="Search workspaces by name, application, or tag..." 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   IsHitTestVisible="False" Margin="34,0,12,0" VerticalAlignment="Center"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Category Pills -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Category:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding}" Margin="0,0,8,0" Padding="12,5"
                                                 GroupName="CategoriesGroup"
                                                 IsChecked="{Binding DataContext.SelectedCategory, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, Converter={x:Null}}">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="pill" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                                    <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#FFFFFF" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Restoring Banner -->
            <Border Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibilityConverter}}" 
                    Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource SymbolFont}" FontSize="14" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RestoringStatusText}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Empty State -->
            <Border Visibility="{Binding HasWorkspaces, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                    Style="{StaticResource CardBorderStyle}" Padding="40,32" Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="26" 
                            Background="{DynamicResource SurfaceBackgroundBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                            Margin="0,0,0,14" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource SymbolFont}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                    </Border>
                    
                    <TextBlock Text="No workspaces found" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Capture your current desktop arrangement or adjust your search filter to see your saved stages." 
                               FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" TextAlignment="Center" MaxWidth="440" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Capture Desktop Workspace" Command="{Binding StartCaptureCommand}" Margin="0,0,10,0" Padding="18,8" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Clear Filter" Command="{Binding ClearFilterCommand}" Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Workspace Cards Grid -->
            <ItemsControl ItemsSource="{Binding FilteredWorkspaces}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:WorkspaceItemViewModel}">
                        <Border Width="325" Margin="0,0,16,16" Padding="20" CornerRadius="12">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Category, Display Count, and Pin Button -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                        <!-- Category Tag (Centered, Height=20) -->
                                        <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="4" Height="20" Padding="6,0" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                        </Border>

                                        <!-- Displays Tag (Centered, Height=20) -->
                                        <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="4" Height="20" Padding="6,0" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource SymbolFont}" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding MonitorSummaryText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Pinned Pill (Centered Text, Height=20, No Dots) -->
                                        <Border Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="{DynamicResource AccentBrush}" CornerRadius="4" Height="20" Padding="6,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE718;" FontFamily="{StaticResource SymbolFont}" FontSize="9" Foreground="#FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="PINNED" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Pin Toggle Button -->
                                    <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Padding="6,4"
                                            Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" ToolTip="Toggle Pinned State">
                                        <TextBlock Text="{Binding IsPinned, Converter={StaticResource PinGlyphConverter}}" FontFamily="{StaticResource SymbolFont}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Button>
                                </Grid>

                                <!-- Title -->
                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,5" />

                                <!-- Description -->
                                <TextBlock Grid.Row="2" Text="{Binding Description, TargetNullValue='No description provided'}" 
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" 
                                           TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />

                                <!-- App Icons & Metadata -->
                                <Grid Grid.Row="3" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- App Icons Strip & Compact Count -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding AppPreviews}" Margin="0,0,6,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type viewmodels:AppPreviewItem}">
                                                    <Border Width="24" Height="24" CornerRadius="5" 
                                                            Background="{DynamicResource SurfaceBackgroundBrush}" 
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                                                            Margin="0,0,4,0" ToolTip="{Binding DisplayName}">
                                                        <TextBlock Text="{Binding IconGlyph}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Height="22" Padding="6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CompactAppCountText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding LastRestoredText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Action Buttons (All Height="32" for Exact Uniformity) -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Primary Restore Button with Emerald Hover Glow -->
                                    <Button Grid.Column="0" Style="{StaticResource RestoreButtonStyle}" Content="Restore" 
                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Height="32" Padding="14,0" VerticalAlignment="Center" Margin="0,0,6,0" />

                                    <!-- Details Button -->
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Details" 
                                            Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Height="32" Padding="12,0" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="View and Edit Applications" />

                                    <!-- Duplicate Button with Vector Copy Icon -->
                                    <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" 
                                            Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Height="32" Width="32" Padding="0" VerticalAlignment="Center" Margin="0,0,2,0" ToolTip="Duplicate Workspace">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource SymbolFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>

                                    <!-- Delete Button with Vector Trash Icon -->
                                    <Button Grid.Column="3" Style="{StaticResource GhostButtonStyle}" 
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Height="32" Width="32" Padding="0" VerticalAlignment="Center" ToolTip="Delete Workspace">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource SymbolFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
